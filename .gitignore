# Dependencies — restored from the lockfiles, never committed.
node_modules/

# Build output. `arise/dist` is a byte-for-byte copy of the runtime set made by
# tools/package.js, and english-feedback-app builds its own; both are produced
# from what is already tracked.
dist/
build/
.wrangler/
.vite/

# Real secrets. The *.example files ARE tracked on purpose — they document the
# shape without carrying a value. `.env.development` is likewise tracked and
# holds only a localhost URL. Anything below would hold the actual key.
.env
.env.local
.env.production
.dev.vars
*.pem
*.key

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Scratch: a lock file the scheduler writes, and screenshots.
.claude/scheduled_tasks.lock
*.log

# Design-tool exports. These are self-extracting bundles — a megabyte of gzipped
# React that references external font and CDN origins and links none of the
# app's own files. They are useful to READ a design out of and must never be
# merged into the app; arise/CLAUDE.md marks that Critical. Keep them on disk,
# out of the repository.
*Redesign*.html
*standalone*.html
