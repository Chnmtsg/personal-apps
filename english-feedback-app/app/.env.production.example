# Copy to app/.env.production and fill in before running `npm run build`.
# The build fails if VITE_API_URL is missing, not https, or points at localhost.

VITE_API_URL=https://english-feedback-proxy.<your-subdomain>.workers.dev

# Only if you set the worker's APP_KEY secret. Must match it exactly.
# This value ships inside the public bundle — it deters casual abuse of your
# API key, it does not authenticate anyone.
# VITE_APP_KEY=
