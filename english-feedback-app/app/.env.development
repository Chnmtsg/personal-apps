# Dev only. `npm run dev:worker` serves the proxy at this address.
#
# This lives in .env.development rather than .env on purpose: a plain .env
# applies to every mode, so the localhost URL used to be compiled into
# production builds — an installed PWA would call 127.0.0.1 and be blocked as
# mixed content. Production values belong in .env.production.
VITE_API_URL=http://127.0.0.1:8787
